  "tour": [
    {
      "view": "side",
      "title": "A silhouette from the archive",
      "text": "For 2006-2007 Canyon rebuilt the SpeedMax around the New MR3 frame while keeping the proven triathlon geometry. In 2007 team UNIBET's time-trial riders used a separate SpeedMax TT Pro with its own TT geometry; no photograph of that bike survives in the archive."
    },
    {
      "view": "cockpit",
      "title": "Cockpit of its era",
      "text": "Clip-on extensions, cable housings and the cockpit hardware documented for this build. Side profiles are traced from the archived photograph; depths remain interpreted."
    },
    {
      "view": "drivetrain",
      "title": "The drivetrain, as listed",
      "text": "53 / 39 rings with a Dura-Ace 12–23 cassette. Switch to Ride to see cadence drive the wheels through the listed ratio."
    },
    {
      "view": "nds",
      "title": "The other side of the story",
      "text": "Brakes, hubs and frame details follow the archived specification. Where the photo is silent, shapes are inferred and marked as such."
    },
    {
      "view": "hero",
      "title": "Exhibit 04 · SpeedMax 3.0 · MY2007",
      "text": "A photo-calibrated reconstruction. Orbit freely, repaint it in the Customizer, or light it in the Aero lab. Sources and uncertainties are listed in Specs."
    }
