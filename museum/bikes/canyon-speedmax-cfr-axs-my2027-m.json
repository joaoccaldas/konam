{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:canyon-triathlon-museum:bike:v1",
  "title": "Reference-backed bike exhibit",
  "type": "object",
  "required": ["schema_version", "id", "brand", "model", "model_year", "size", "status", "coordinate_system", "references", "reconstruction_adapter", "uncertainties", "deliverables", "validation"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "brand": {"type": "string"},
    "model": {"type": "string"},
    "model_year": {"type": ["integer", "null"]},
    "launch_year": {"type": ["integer", "null"]},
    "size": {"type": "string"},
    "status": {"enum": ["research", "modelling", "reference-study", "independently-validated"]},
    "coordinate_system": {"type": "object", "required": ["unit", "forward", "up", "drive_side"]},
    "reconstruction_adapter": {"type": "string"},
    "references": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "url", "sha256", "role"], "properties": {"path": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "role": {"type": "string"}}}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "deliverables": {"type": "object", "required": ["bike", "scene", "glb", "viewer"]},
    "validation": {"type": "object", "required": ["geometry", "silhouette", "renders"]}
  }
}