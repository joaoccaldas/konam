{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caldas.studio/schemas/tech-room-v1.json",
  "title": "Caldas Studio Tech Room V1",
  "type": "object",
  "required": ["schema_version","id","provider_id","title","products","features","partnership_status"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "provider_id": { "type": "string" },
    "title": { "type": "string" },
    "partnership_status": { "enum": ["unofficial-concept","affiliate-approved","partner-approved"] },
    "products": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "features": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "stories": { "type": "array", "items": { "type": "string" } },
    "support_sources": { "type": "array", "items": { "type": "string" } },
    "offer_ids": { "type": "array", "items": { "type": "string" } },
    "theme": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": true
}
