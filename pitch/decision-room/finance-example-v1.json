      "label": "Sell 20% more",
      "units": 1200,
      "price": 100,
      "cost": 60,
      "revenue": 120000,
      "expenses": 97000,
      "profit": 23000,
      "volumeEffect": 8000,
      "priceEffect": 0,
      "costEffect": 0,
      "change": 8000
    },
    {
      "id": "price",
      "label": "A 5% price cut",
