{
  "name": "web",
  "version": "1.0.0",
  "description": "Canyon Museum interactive 3D web runtime",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:unit": "node --test test/*.test.mjs",
    "build:landing": "node build_landing.mjs",
    "test:visual": "node artworld-visual-smoke.mjs",
    "build:harden": "node ../tools/harden_pages.mjs",
    "build:site": "node build_landing.mjs && node ../tools/build_collection.mjs && node ../tools/harden_pages.mjs",
    "audit:phones": "node phone-layout-audit.mjs",
    "audit:zfight": "node zfight-audit.mjs",
    "validate:bikes": "cd .. && node tools/validate-bikes.mjs",
    "check": "npm test && npm run validate:bikes",
    "build": "cd .. && node tools/build_pages.mjs"
  },
  "keywords": [
    "threejs",
    "blender",
    "triathlon",
    "museum"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "esbuild": "^0.28.2",
    "meshoptimizer": "^1.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
