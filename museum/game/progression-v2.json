  "admin_policy": {
    "full_visibility": true,
    "bypass_progression_visibility": true,
    "mutations_still_use_normal_safety_rules": true
  },
  "ranking_policy": {
    "source": "server-verified-population",
    "minimum_population": 25,
    "anonymous_label": "Unranked",
    "metrics": [
      "xp",
      "level",
      "discoveries",
      "collections",
      "race_badges"
    ],
    "note": "Never fabricate percentile or rank from local-only data."
  },
  "surprise_policy": {
    "min_level": 2,
    "max_per_session": 1,
    "min_visits_between": 2,
    "eligible_surfaces": [
      "home",
      "discover",
      "garage",
      "studio",
      "progress"
    ],
    "positions": [
      "top-right",
      "lower-left",
      "edge-center"
    ],
    "rarity_by_min_level": {
      "common": 2,
      "uncommon": 2,
      "rare": 6,
      "epic": 7,
      "legendary": 9,
      "mythic": 10
    },
    "note": "Deterministic per session/date for testability; never paid; one-time reward per relic.",
    "start_visit": 4
  },
  "visibility_policy": {
    "public_product_information": "always",
    "locked_product_preview": "tease",
    "locked_room_preview": "map-silhouette",
    "immersive_room_entry": "progression",
    "bike_3d_studio": "progression",
    "bike_save_and_equip": "progression",
    "avatar_items": "progression",
    "admin": "all-current-content"
  }
}
