{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caldas.studio/schemas/story-v1.json",
  "title": "Caldas Studio Story / Experience V1",
  "type": "object",
  "required": ["schema_version", "id", "story_type", "title", "beats", "public"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "story_type": {
      "enum": ["product", "athlete", "science", "race", "history", "place", "campaign"]
    },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "public": { "type": "boolean" },
    "event_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "entity_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "enum": ["brand", "product", "athlete", "event", "course", "place", "result", "research", "sponsor", "media"]
          },
          "role": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "enum": ["reveal", "inspect", "compare", "explain", "timeline", "location", "data", "choice", "cta"]
          },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "entity_refs": { "type": "array", "items": { "type": "string" } },
          "scene_ref": { "type": ["string", "null"] },
          "interaction": { "type": ["string", "null"] },
          "source_records": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "sponsorship": {
      "type": ["object", "null"],
      "properties": {
        "sponsor_id": { "type": "string" },
        "disclosure": { "type": "string", "minLength": 1 },
        "editorial_independence": { "type": "boolean" }
      },
      "required": ["sponsor_id", "disclosure", "editorial_independence"],
      "additionalProperties": false
    },
    "source_records": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
