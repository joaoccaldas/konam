{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joaoccaldas.github.io/canyonmuseum/schemas/v1/unlock.schema.json",
  "title": "Unlock",
  "type": "object",
  "required": ["id", "requirements", "reward"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^unlock:" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["level", "tier", "collection"] },
          "min": {},
          "prefix": { "type": "string" },
          "id": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "reward": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["badge", "cosmetic", "room", "feature", "equipment-slot", "garage-bay", "avatar-item", "bike", "bike-group", "room-group", "surprise-tier"] },
        "id": { "type": "string" }
      }
    }
  }
}
