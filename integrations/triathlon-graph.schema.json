{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caldas.studio/schemas/triathlon-graph-v1.json",
  "title": "Caldas Studio Triathlon Graph V1",
  "type": "object",
  "required": ["schema_version", "nodes", "edges"],
  "properties": {
    "schema_version": { "const": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "public"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "kind": {
            "enum": [
              "brand", "product", "athlete", "event", "course", "place",
              "result", "story", "research", "collection", "race_setup",
              "experience", "sponsor", "commerce_offer", "media"
            ]
          },
          "public": { "type": "boolean" },
          "label": { "type": "string" },
          "canonical_url": { "type": ["string", "null"], "format": "uri-reference" },
          "source_records": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "relationship", "to"],
        "properties": {
          "from": { "type": "string" },
          "relationship": {
            "enum": [
              "manufactured_by",
              "raced_by",
              "appeared_at",
              "used_in",
              "configured_for",
              "explained_by",
              "featured_in",
              "sponsored_by",
              "available_via",
              "located_at",
              "part_of",
              "contains",
              "compatible_with",
              "equipped_in",
              "related_to"
            ]
          },
          "to": { "type": "string" },
          "evidence": {
            "enum": ["published", "reference-calibrated", "inferred", "generated", "provisional"]
          },
          "source_records": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
